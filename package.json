{
  "name": "texasholdem",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Texas Hold'em Sit & Go \u2013 browser game against computer opponents",
  "scripts": {
    "dev": "VITE_CONFIG_NATIVE_IGNORE_WARNING=true vite",
    "build": "VITE_CONFIG_NATIVE_IGNORE_WARNING=true vite build",
    "preview": "VITE_CONFIG_NATIVE_IGNORE_WARNING=true vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json",
