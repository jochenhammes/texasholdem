{
  "name": "texasholdem",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Texas Hold'em Sit & Go \u2013 browser game against computer opponents",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:rules": "npx -y firebase-tools@15 emulators:exec --only database --project demo-holdem \"vitest run --config firebase/vitest.config.ts\"",
    "emulator": "npx -y firebase-tools@15 emulators:start --only database --project demo-holdem",
    "dev:mp": "VITE_FIREBASE_EMULATOR=1 vite"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tsconfig/svelte": "^5.0.8",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.8",
    "typescript": "~6.0.3",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "firebase": "^13.2.0"
  }
}
